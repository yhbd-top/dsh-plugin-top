{
  "name": "dsh-plugin-top",
  "version": "0.5.0",
  "description": "yhbd.top 插件雷达：DSH 侧边栏 plugin_top 按钮 + 大面板（搜索 / 分类 / 站点同款五榜单：原生星榜·飙升·今日新秀·兼容工具·分类冠军），数据由插件内嵌的同源 HTTP 反代拉取，无需 CORS / nginx 配置；「安装」一键写入会话输入框；附带 Agent 可调用的搜索/榜单工具。",
  "type": "module",
  "main": "dist/index.mjs",
  "exports": {
    ".": "./dist/index.mjs",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh-bundle",
    "cordis",
    "plugin-marketplace",
    "yhbd"
  ],
  "license": "MIT",
  "homepage": "https://www.yhbd.top",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yhbd-top/dsh-plugin-top.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "tsdown && node scripts/build-client.cjs",
    "build:server": "tsdown",
    "build:client": "node scripts/build-client.cjs",
    "prepare": "tsdown && node scripts/build-client.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "^0.0.1-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/schemastery": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/schemastery": "latest",
    "tsdown": "latest",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
